      "source": [
        "F_fun <- function(x) {\n",
        "  ifelse(x<0,0,ifelse(x>1,1,3*x^2 - 2*x^3))\n",
        "}\n",
        "\n",
        "P <- F_fun(2/3) - F_fun(1/3)\n",
        "P"
